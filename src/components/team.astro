---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Sectionhead from "@/components/sectionhead.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const members = (await getCollection("team")).sort(
  (a, b) => a.data.order - b.data.order
);

const initials = (name: string) =>
  name
    .split(" ")
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<Sectionhead id="team">
  <Fragment slot="title">The Team</Fragment>
  <Fragment slot="desc">The people building Native and what each of us owns.</Fragment>
</Sectionhead>

<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mx-auto max-w-5xl mt-12">
  {
    members.map(({ data }) => (
      <div class="group">
        <div class="w-full aspect-square">
          {data.photo ? (
            <img
              src={`${base}/team/${data.photo}`}
              alt={data.name}
              width="400"
              height="400"
              class="w-full rounded-sm transition group-hover:-translate-y-1 group-hover:shadow-xl bg-white object-cover object-center aspect-square"
            />
          ) : (
            <div class="w-full aspect-square rounded-sm bg-black text-white flex items-center justify-center text-6xl font-bold transition group-hover:-translate-y-1 group-hover:shadow-xl">
              {initials(data.name)}
            </div>
          )}
        </div>

        <div class="mt-4 text-center">
          <h3 class="text-lg font-semibold text-gray-800">{data.name}</h3>
          <p class="text-sm text-slate-500">{data.role}</p>
          <a
            href={`mailto:${data.email}`}
            class="mt-2 inline-flex items-center gap-1 text-sm text-slate-600 hover:text-black break-all">
            <Icon class="w-4 h-4 shrink-0" name="bx:bxs-envelope" />
            {data.email}
          </a>
        </div>
      </div>
    ))
  }
</div>
