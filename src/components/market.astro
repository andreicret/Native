---
import { Icon } from "astro-icon/components";
import Sectionhead from "@/components/sectionhead.astro";

// TODO: customer segments
const segments = [
  { title: "Primary segment", description: "Who they are and what they need." },
  { title: "Secondary segment", description: "Who they are and what they need." },
  { title: "Early adopters", description: "Who will try Native first and why." },
];
---

<Sectionhead id="market">
  <Fragment slot="title">Customer Segments</Fragment>
  <Fragment slot="desc">Who we build Native for.</Fragment>
</Sectionhead>

<div class="max-w-5xl mx-auto">
  <div class="grid md:grid-cols-3 gap-6 mt-12">
    {
      segments.map((item) => (
        <div class="border-2 border-gray-200 rounded-md p-6">
          <Icon class="w-8 h-8" name="bx:bxs-group" />
          <h3 class="font-semibold text-lg mt-4">{item.title}</h3>
          <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        </div>
      ))
    }
  </div>
</div>
