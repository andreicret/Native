---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<section
  id="top"
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="Native hero illustration"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
      Software Engineering Project · 2026
    </p>
    <h1
      class="mt-3 text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Native
    </h1>
    <!-- TODO: one-line pitch -->
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      A one-sentence pitch that explains what Native does and for whom.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link href="#problem" class="flex gap-1 items-center justify-center">
        <Icon class="text-white w-5 h-5" name="bx:bxs-rocket" />
        Discover the project
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/andreicret/Native"
        class="flex gap-1 items-center justify-center"
        target="_blank">
        <Icon class="text-black w-4 h-4" name="bx:bxl-github" />
        GitHub Repo
      </Link>
    </div>
  </div>
</section>
