---
import { Image } from "astro:assets";
import logoImage from "@/assets/native-logo.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<section id="top" class="pt-16 pb-8 md:pt-12 md:pb-24">
  <div>
    <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
      Speak like a Native
    </p>
    <h1 class="mt-4">
      <Image
        src={logoImage}
        alt="Native"
        widths={[320, 640, 960]}
        sizes="(max-width: 640px) 80vw, 420px"
        loading="eager"
        class="w-64 sm:w-80 xl:w-[26rem] h-auto"
      />
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      App designed to improve your language skills like never before.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link href="#problem" class="flex gap-1 items-center justify-center">
        <Icon class="text-white w-5 h-5" name="bx:bxs-rocket" />
        Discover the project
      </Link>
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/andreicret/Native"
        class="flex gap-1 items-center justify-center"
        target="_blank">
        <Icon class="text-black w-4 h-4" name="bx:bxl-github" />
        GitHub Repo
      </Link>
    </div>
  </div>
</section>
