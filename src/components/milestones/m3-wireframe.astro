---
import { Image } from "astro:assets";
import wireframe from "@/assets/Wireframe.jpeg";
---

<figure class="mt-4">
  <a
    href={wireframe.src}
    target="_blank"
    rel="noopener"
    aria-label="Open the Native wireframe at full size">
    <Image
      src={wireframe}
      alt="Hand-drawn Native wireframe showing lesson selection by language, level and category, a video lesson with bilingual text, and phrase-completion exercises."
      widths={[640, 1080]}
      sizes="(max-width: 1023px) 100vw, (max-width: 1279px) calc(100vw - 224px), calc(100vw - 256px)"
      class="h-auto w-full max-w-5xl"
    />
  </a>
</figure>