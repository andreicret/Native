---
import { Icon } from "astro-icon/components";
import Sectionhead from "@/components/sectionhead.astro";

const pains = [
  {
    title: "Vocabulary over understanding",
    description: "Learners memorise words without understanding how the language actually works.",
  },
  {
    title: "No sentence building",
    description: "Little practice in constructing sentences, developing complex ideas or formulating sophisticated expressions.",
  },
  {
    title: "No real conversation",
    description: "Learners are not prepared to engage in meaningful, fluent conversations.",
  },
];
---

<Sectionhead id="problem">
  <Fragment slot="title">The Problem</Fragment>
  <Fragment slot="desc">
    Current language-learning solutions on the market tend to focus on
    vocabulary acquisition rather than developing a deeper understanding of how
    the language works. While they help learners expand their vocabulary, they
    often fail to teach them how to construct sentences, develop complex ideas,
    formulate more sophisticated expressions, and engage in meaningful, fluent
    conversations.
  </Fragment>
</Sectionhead>

<div class="grid md:grid-cols-3 gap-6 mt-12 max-w-5xl mx-auto">
  {
    pains.map((item) => (
      <div class="border-2 border-gray-200 rounded-md p-6">
        <Icon class="w-8 h-8 text-red-500" name="bx:bxs-error" />
        <h3 class="font-semibold text-lg mt-4">{item.title}</h3>
        <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
      </div>
    ))
  }
</div>
