---
// @ts-ignore
import { Icon } from "astro-icon/components";
import Sectionhead from "@/components/sectionhead.astro";

const steps = [
  {
    label: "Watch",
    title: "Immersive multimedia lessons",
    description:
      "Our platform offers immersive, extended learning sessions built around engaging multimedia content, including animations, interviews, documentaries, and selected scenes from films and animated productions.",
    tags: ["Animations", "Interviews", "Documentaries", "Film scenes", "Animated productions"],
    icon: "bx:bxs-videos",
  },
  {
    label: "Practice",
    title: "Context-driven exercises",
    description:
      "Each lesson is followed by interactive, context-driven exercises designed not only to expand learners’ vocabulary, but also to develop their ability to construct sentences independently, express complex ideas, and respond naturally in realistic conversational scenarios.",
    tags: [],
    icon: "bx:bxs-brain",
  },
  {
    label: "Speak",
    title: "Real-life conversations",
    description:
      "By simulating real-life situations in which learners must actively use the target language, our approach bridges the gap between understanding a language and being able to communicate effectively in it.",
    tags: [],
    icon: "bx:bxs-conversation",
  },
];
---

<Sectionhead id="solution">
  <Fragment slot="title">Our Solution</Fragment>
  <Fragment slot="desc">How Native solves the problem and the value it brings.</Fragment>
</Sectionhead>

<div
  class="bg-black p-8 md:px-20 md:py-16 mt-12 mx-auto max-w-5xl rounded-lg text-center">
  <p class="text-slate-400 text-sm uppercase tracking-widest">Value proposition</p>
  <p class="text-white text-2xl md:text-4xl tracking-tight mt-4 leading-snug">
    Native bridges the gap between{" "}
    <span class="text-slate-400">understanding a language</span> and being able
    to <span class="text-slate-400">communicate effectively</span> in it.
  </p>
</div>

<ol class="grid md:grid-cols-3 gap-6 mt-12 max-w-5xl mx-auto">
  {
    steps.map((item, index) => (
      <li class="relative flex flex-col border-2 border-gray-200 rounded-md p-6 transition hover:-translate-y-1 hover:shadow-xl hover:border-black">
        <div class="flex items-center justify-between">
          <div class="bg-black rounded-full p-2 w-10 h-10 shrink-0">
            <Icon class="text-white" name={item.icon} />
          </div>
          <span class="text-sm font-semibold uppercase tracking-widest text-slate-400">
            0{index + 1} · {item.label}
          </span>
        </div>
        <h3 class="font-semibold text-lg mt-5">{item.title}</h3>
        <p class="text-slate-500 mt-2 leading-relaxed">{item.description}</p>
        {item.tags.length > 0 && (
          <ul class="flex flex-wrap gap-2 mt-4">
            {item.tags.map((tag) => (
              <li class="px-2.5 py-1 rounded-full bg-gray-100 text-sm text-gray-800">{tag}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<p class="text-lg text-slate-600 mt-8 max-w-5xl mx-auto border-l-4 border-black pl-4">
  Rather than simply memorizing words and grammatical rules, learners are
  encouraged to think, formulate their own responses, and develop the
  confidence and linguistic skills needed to engage in meaningful
  conversations.
</p>
