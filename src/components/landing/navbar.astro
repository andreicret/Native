---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "@/assets/native-logo.png";
---

<header class="landing-header">
  <Image src={logo} alt="Native" width={180} loading="eager" class="native-logo" />
  <a href="#cum-functioneaza" class="how-it-works">
    Cum funcționează?
    <Icon name="bx:bx-down-arrow-alt" width={18} height={18} aria-hidden="true" />
  </a>
</header>

<style>
  .landing-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 32px 48px;
  }

  .native-logo {
    width: 180px;
    height: auto;
    filter: grayscale(1) brightness(0);
  }

  .how-it-works {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 11px 16px;
    background: transparent;
    color: inherit;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  @media (max-width: 1100px) {
    .landing-header {
      gap: 20px;
      padding: 24px;
    }

    .native-logo {
      width: 160px;
    }

    .how-it-works {
      font-size: 16px;
    }
  }

  @media (max-width: 540px) {
    .native-logo {
      width: 104px;
    }

    .landing-header {
      gap: 12px;
      padding: 20px;
    }

    .how-it-works {
      min-height: 42px;
      gap: 6px;
      padding: 9px 10px;
      font-size: 12px;
    }
  }
</style>