---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "@/assets/native-logo.png";
---

<header class="landing-header">
  <Image src={logo} alt="Native" width={180} loading="eager" class="native-logo" />
  <nav aria-label="Main navigation" class="main-navigation">
    <button type="button" aria-disabled="true">About</button>
    <button type="button" aria-disabled="true">More</button>
  </nav>
  <div class="account-actions">
    <button type="button" aria-disabled="true">Sign in</button>
    <button type="button" aria-disabled="true">Log in</button>
    <button type="button" aria-disabled="true" class="download-button">
      <Icon name="bx:download" width={18} height={18} aria-hidden="true" />
      Download app
    </button>
  </div>
</header>

<style>
  .landing-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
    padding: 32px 48px;
  }

  .native-logo {
    width: 160px;
    height: auto;
    filter: grayscale(1) brightness(0);
  }

  .main-navigation,
  .account-actions {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .account-actions {
    justify-self: end;
    gap: 22px;
  }

  button {
    background: transparent;
    color: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
    padding: 8px 0;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 11px 16px;
  }

  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 5px;
  }

  @media (max-width: 1000px) {
    .landing-header {
      grid-template-columns: 1fr auto;
      gap: 20px;
      padding: 24px;
    }

    .main-navigation {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: center;
    }

    .account-actions {
      grid-row: 1;
      grid-column: 2;
    }
  }

  @media (max-width: 540px) {
    .native-logo {
      width: 120px;
    }

    .account-actions {
      display: grid;
      grid-template-columns: auto auto;
      gap: 4px 20px;
      justify-items: center;
    }

    .download-button {
      grid-column: 1 / -1;
      padding: 9px 12px;
    }
  }
</style>