<section class="language-picker" aria-labelledby="learning-heading">
  <h1 id="learning-heading">
    <span class="greeting" data-greeting lang="en">Hello,</span>
    <span class="question">What language do you want to learn today?</span>
  </h1>
  <form class="language-form" data-language-form>
    <label class="sr-only" for="language">Language you want to learn</label>
    <input
      id="language"
      name="language"
      type="text"
      placeholder="Type a language"
      autocomplete="off"
    />
    <button type="submit">Submit</button>
  </form>
</section>

<script>
  const greetings = [
    { text: "Hello", lang: "en" },
    { text: "Hola", lang: "es" },
    { text: "Salut", lang: "fr" },
    { text: "Bun\u0103", lang: "ro" },
    { text: "Ciao", lang: "it" },
    { text: "Hallo", lang: "de" },
    { text: "Ol\u00e1", lang: "pt" },
    { text: "Hej", lang: "sv" },
    { text: "Ahoj", lang: "cs" },
  ];

  const greeting = document.querySelector<HTMLElement>("[data-greeting]");
  const selected = greetings[Math.floor(Math.random() * greetings.length)];

  if (greeting) {
    greeting.textContent = `${selected.text},`;
    greeting.lang = selected.lang;
  }

  document.querySelector<HTMLFormElement>("[data-language-form]")?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

