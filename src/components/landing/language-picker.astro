<section class="language-picker" aria-labelledby="learning-heading">
  <h1 id="learning-heading">
    <span class="greeting" data-greeting lang="en">Hello,</span>
    <span class="question">Ce limbă vrei să înveți astăzi?</span>
  </h1>
  <div class="language-options" role="group" aria-label="Sugestii de limbi">
    <button type="button">Engleză</button>
    <button type="button">Franceză</button>
    <button type="button">Spaniolă</button>
    <button type="button">Germană</button>
    <button type="button">Italiană</button>
  </div>
</section>

<script>
  const greetings = [
    { text: "Hello", lang: "en" },
    { text: "Hola", lang: "es" },
    { text: "Salut", lang: "fr" },
    { text: "Bun\u0103", lang: "ro" },
    { text: "Ciao", lang: "it" },
    { text: "Hallo", lang: "de" },
    { text: "Ol\u00e1", lang: "pt" },
    { text: "Hej", lang: "sv" },
    { text: "Ahoj", lang: "cs" },
  ];

  const greeting = document.querySelector<HTMLElement>("[data-greeting]");
  const selected = greetings[Math.floor(Math.random() * greetings.length)];

  if (greeting) {
    greeting.textContent = `${selected.text},`;
    greeting.lang = selected.lang;
  }
</script>

