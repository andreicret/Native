---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/landing/navbar.astro";
import LanguagePicker from "@/components/landing/language-picker.astro";
import FeatureShowcase from "@/components/landing/feature-showcase.astro";
---

<Layout
  title="Învață o limbă"
  lang="ro"
  description="Native - Învață o limbă nouă și vorbește cu încredere."
  chrome={false}>
  <div class="landing-page">
    <Navbar />
    <main>
      <LanguagePicker />
      <FeatureShowcase />
    </main>
  </div>
</Layout>

<style>
  .landing-page {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    background: #fff;
    color: #111;
    letter-spacing: 0;
  }

  main {
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: center;
    padding: 16px 24px 48px;
  }

  @media (max-width: 540px) {
    main {
      padding: 12px 24px 40px;
    }
  }
</style>