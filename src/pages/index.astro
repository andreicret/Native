---
import Container from "@/components/container.astro";
import Hero from "@/components/hero.astro";
import Team from "@/components/team.astro";
import Layout from "@/layouts/Layout.astro";
import MilestoneSection from "@/components/milestones/milestone-section.astro";
import MilestonesSidebar from "@/components/milestones-sidebar.astro";
import { milestones } from "@/data/milestones";
---

<Layout title="" sidebar>
  <MilestonesSidebar milestones={milestones} />
  <Container>
    <Hero />
    <Team />
    <div id="milestones" class="mt-12">
      {milestones.map((milestone) => <MilestoneSection milestone={milestone} />)}
    </div>
  </Container>
</Layout>
