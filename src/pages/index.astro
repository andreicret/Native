---
import Business from "@/components/business.astro";
import Competition from "@/components/competition.astro";
import Container from "@/components/container.astro";
import Hero from "@/components/hero.astro";
import Market from "@/components/market.astro";
import Metrics from "@/components/metrics.astro";
import Problem from "@/components/problem.astro";
import Solution from "@/components/solution.astro";
import Team from "@/components/team.astro";
import Layout from "@/layouts/Layout.astro";
import M2Discovery from "@/components/milestones/m2-discovery.astro";

const milestones = [
  { id: "m1", title: "Fiki & Project description", sections: [] },
  {
    id: "m2",
    title: "Validation 1 (idea)",
    sections: [
      {
        title: "How we identified the problem",
        content:
          'The problem was identified by observing a common frustration among language learners: the illusion of fluency. We noticed that users spend months or even years on traditional language apps, maintaining impressive "streaks" and accumulating vocabulary, only to freeze when placed in a real-world conversation with a native speaker. We realized the core problem is not a lack of grammar resources, but the absence of an accessible environment designed to train conversational fluency, spontaneity, and confidence in real-life contexts.',
      },
      {
        title: "The proposed solution: the Native app",
        content:
          "Our solution shifts the paradigm from rote memorization to conversational immersion. Instead of merely testing basic translations, the app is designed to simulate authentic interactions.\n\n• It provides practical scenarios (e.g., ordering at a restaurant, job interviews, airport interactions) rather than isolated phrases.\n• By displaying captions in both languages, the app builds a subconscious cognitive bridge, helping users naturally link the two languages and accelerate their comprehension.",
      },
      { title: "Customer discovery plan", content: "" },
      { title: "Customer discovery process in detail", Component: M2Discovery },
      { title: "How the insights affected our product", content: "" },
      { title: "Are we ready for Customer Validation?", content: "" },
    ],
  },
  {
    id: "m3",
    title: "Mockups & Landing page",
    sections: [
      { title: "Mockups", content: "" },
      { title: "Landing page", content: "" },
    ],
  },
  {
    id: "m4",
    title: "Persona, Flow, User stories / Use cases, Architecture",
    sections: [
      { title: "Persona", content: "" },
      { title: "User flow", content: "" },
      { title: "User stories / Use cases", content: "" },
      { title: "Architecture", content: "" },
    ],
  },
  {
    id: "m5",
    title: "Validation 2 (design, UX)",
    sections: [
      { title: "Design and UX validation", content: "" },
      { title: "Feedback and improvements", content: "" },
    ],
  },
  {
    id: "m6",
    title: "Market research",
    sections: [{ title: "Research and findings", content: "" }],
  },
  {
    id: "m7",
    title: "MVP",
    sections: [
      { title: "Minimum viable product", content: "" },
      { title: "Demo and implementation", content: "" },
    ],
  },
  {
    id: "m8",
    title: "First sale",
    sections: [{ title: "First sale and results", content: "" }],
  },
  {
    id: "m9",
    title: "Slides",
    sections: [{ title: "Presentation slides", content: "" }],
  },
  {
    id: "m11",
    title: "Overall project presentation (Fiki - final version)",
    sections: [{ title: "Final project presentation", content: "" }],
  },
];
---

<Layout title="">
  <Container>
    <Hero />
    <Team />
    <div id="milestones" class="mt-24 border-t border-gray-200 pt-10">
      <h2 class="text-3xl font-bold text-gray-900">Project milestones</h2>
      <nav aria-label="Project milestones" class="mt-6">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {
            milestones.map((milestone) => (
              <li>
                <a
                  href={`#${milestone.id}`}
                  aria-label={`${milestone.id.toUpperCase()}: ${milestone.title}`}
                  class="inline-block py-2 font-semibold text-gray-600 underline decoration-gray-300 underline-offset-8 hover:text-gray-900 hover:decoration-gray-900 focus-visible:outline-2 focus-visible:outline-offset-4">
                  {milestone.id.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    {
      milestones.map((milestone) => (
        <section
          id={milestone.id}
          aria-labelledby={`${milestone.id}-title`}
          class="mt-12 border-t border-gray-200 py-10">
          <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <p class="text-sm font-semibold uppercase tracking-normal text-gray-500">
                Milestone {milestone.id.slice(1)} ({milestone.id.toUpperCase()})
              </p>
              <h2
                id={`${milestone.id}-title`}
                class="mt-2 text-2xl font-bold text-gray-900 sm:text-3xl">
                {milestone.title}
              </h2>
            </div>
          </header>
          {milestone.id === "m1" ? (
            <>
              <Problem />
              <Solution />
              <Market />
              <Competition />
              <Metrics />
              <Business />
            </>
          ) : (
            <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
              {milestone.sections.map(({ title, content, Component }) => (
                <div class={Component ? "min-w-0 md:col-span-2" : "min-w-0"}>
                  <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
                  {Component ? (
                    <Component />
                  ) : (
                    <p class="mt-2 whitespace-pre-line break-words leading-relaxed text-gray-500">
                      {content || "Not yet documented."}
                    </p>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>
      ))
    }
  </Container>
</Layout>
